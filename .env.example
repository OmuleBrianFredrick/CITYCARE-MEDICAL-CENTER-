APP_NAME="CityCare Medical Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated reverse-proxy IP/CIDR allow-list; leave blank for direct hosting.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=Africa/Kampala

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase production: copy the Session Pooler URI (port 5432) into DB_URL in
# the untracked .env or hosting secret store. Never commit the real URI/password.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=citycare
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true whenever APP_URL uses HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@citycare.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional one-time bootstrap administrator used by DatabaseSeeder.
# For a first deployment, set both values, run php artisan db:seed --force,
# verify the account, then remove them and rebuild the configuration cache.
# Never commit real credentials. Put values only in the untracked deployment .env.
CITYCARE_ADMIN_EMAIL=
CITYCARE_ADMIN_PASSWORD=

# Required only when explicitly running CityCare demo-account or demo-data seeders for local UI testing.
CITYCARE_TEST_PASSWORD=

# Must name a configured private filesystem disk. Never use the public disk.
# Use a durable private disk for multi-node/ephemeral hosting. The optional s3
# disk requires league/flysystem-aws-s3-v3 to be installed and locked first.
CITYCARE_CLINICAL_ATTACHMENTS_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
